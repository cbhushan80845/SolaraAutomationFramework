
pipeline {
    agent any

    tools {
        jdk 'JDK-17'
        maven 'Maven-3'
    }

    stages {
        stage('Verify Tools') {
            steps {
                bat 'java -version'
                bat 'mvn -version'
                bat 'docker --version'
            }
        }
        
        stage('Run Selenium Tests') {
    steps {
        bat '''
            mvn clean test ^
              -Dexecution.mode=remote ^
              -Dbrowser=chrome ^
              -Dapp.url.remote=http://host.docker.internal:5500/search-bars.html ^
              -Dselenium.remote.url=http://localhost:4444/wd/hub
        '''
    }
}

        stage('Build Demo Image') {
            steps {
                bat 'docker build -t rag-demo-app:%BUILD_NUMBER% .'
            }
        }

        stage('Start Test Container') {
            steps {
                bat '''
                    docker rm -f rag-demo-test 2>NUL || exit /b 0
                    docker run -d --name rag-demo-test -p 5501:80 rag-demo-app:%BUILD_NUMBER%
                '''
            }
        }

        stage('Run Selenium Tests on Docker Grid') {
            steps {
                bat '''
                    mvn clean test -Dexecution.mode=remote -Dbrowser=chrome -Dapp.url.remote=http://host.docker.internal:5501/search-bars.html
                '''
            }
        }

        stage('Deploy Demo to Docker') {
            steps {
                bat '''
                    docker rm -f rag-demo-test 2>NUL || exit /b 0
                    docker rm -f rag-demo-app 2>NUL || exit /b 0
                    docker run -d --restart unless-stopped --name rag-demo-app -p 5500:80 rag-demo-app:%BUILD_NUMBER%
                '''
                echo 'Demo application deployed to Docker.'
            }
        }

        stage('Verify Deployment') {
            steps {
                bat '''
                    powershell -NoProfile -Command "$response = Invoke-WebRequest -Uri 'http://localhost:5500/search-bars.html' -UseBasicParsing; if ($response.StatusCode -ne 200) { exit 1 }; Write-Host 'Deployment health check passed: HTTP 200 OK'"
                '''
            }
        }

        stage('Docker Cleanup') {
            steps {
                bat '''
                    docker container prune -f
                    docker image prune -f
                '''
                echo 'Unused Docker containers and dangling images cleaned up.'
            }
        }
    }

    post {
        always {
            junit testResults: '**/target/surefire-reports/*.xml',
                  allowEmptyResults: true

            archiveArtifacts artifacts: 'target/screenshots/**/*.png',
                             allowEmptyArchive: true

            bat 'docker rm -f rag-demo-test 2>NUL || exit /b 0'
        }

        success {
            echo 'Selenium tests passed and demo deployment completed.'
        }

        failure {
            echo 'Pipeline failed. Check the console output.'
        }
    }
}
