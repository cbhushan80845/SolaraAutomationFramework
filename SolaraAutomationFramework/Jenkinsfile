
pipeline {
    agent any

    tools {
        jdk 'JDK-21'
        maven 'Maven-3'
    }

    stages {
        stage('Verify Tools') {
            steps {
                bat 'java -version'
                bat 'mvn -version'
            }
        }

        stage('Run Selenium Tests') {
    steps {
        dir('SolaraAutomationFramework') {
            bat 'mvn clean test -Psmoke'
        }
    }
}
    }

    post {
        always {
            junit testResults: '**/target/surefire-reports/*.xml',
                  allowEmptyResults: true
        }

        success {
            echo 'Automation tests passed successfully.'
        }

        failure {
            echo 'Automation tests failed. Check the console output.'
        }
    }
}
